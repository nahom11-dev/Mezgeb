{
  "name": "mezgeb-showcase",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts --production",
    "build": "npm run build:embed",
    "build:embed": "vite build --config vite.embed.config.ts",
    "clean": "rm -rf dist-embed",

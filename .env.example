# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Voice answers, per interface language. MEZGEB_SPEECH=addis|elevenlabs|gemini|off
#   unset: Amharic → Addis AI (else Gemini); English → ElevenLabs (else Addis AI, else Gemini).
# Read aloud: Amharic → Addis AI, English → ElevenLabs, when their keys are set; otherwise the
#   browser's own voice. MEZGEB_TTS=off always uses the browser's voice.
MEZGEB_SPEECH=""
MEZGEB_TTS=""

# ADDIS_API_KEY: Addis AI key (https://platform.addisassistant.com). Server-side only.
# ADDIS_STT_BACKEND: turbo (default, Amharic + English) or standard (Amharic only).
# ADDIS_TTS_VOICE: Addis Voices 2 voice id for Amharic read-aloud (default am-hamen).
# ADDIS_API_BASE: only to point at another Addis-compatible endpoint.
ADDIS_API_KEY=""
ADDIS_STT_BACKEND="turbo"
ADDIS_TTS_VOICE="am-hamen"
# ADDIS_API_BASE="https://api.addisassistant.com"

# ELEVENLABS_API_KEY: ElevenLabs key (https://elevenlabs.io, free plan: 10,000 credits a month,
#   no commercial licence). Used for English read-aloud and English voice answers. Server-side only.
# ELEVENLABS_VOICE_ID: premade voice for read-aloud (default JBFqnCBsd6RMkjVDRZzb, "George").
# ELEVENLABS_TTS_MODEL / ELEVENLABS_STT_MODEL: defaults eleven_flash_v2_5 / scribe_v2.
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
# ELEVENLABS_TTS_MODEL="eleven_flash_v2_5"
# ELEVENLABS_STT_MODEL="scribe_v2"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MEZGEB_SITE_KEYS: publishable:secret pairs for embed hosts (include pk_sample_* for sample-sites/).
# MEZGEB_ALLOWED_ORIGINS: comma-separated origins of the platforms that embed
# <mezgeb-register> (they may call /api and /v1 from the browser). Example:
# MEZGEB_ALLOWED_ORIGINS="https://savanna.alxafrica.com,http://localhost:8080"
# Level 2 storage (SQLite under this folder; created automatically)
DATA_DIR="./data"

MEZGEB_SITE_KEYS="pk_sample_kelem:sk_sample_kelem,pk_sample_sira:sk_sample_sira,pk_sample_meskot:sk_sample_meskot,pk_sample_savanna:sk_sample_savanna"
MEZGEB_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080"
